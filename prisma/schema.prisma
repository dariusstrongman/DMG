// Prisma schema for DMG Analytics.
// All tables are prefixed `dmg_*` because this project shares the
// `fggruozgfyyheflktcqc` Supabase Postgres instance with Domain Pulse —
// the prefix prevents collisions with the other product's tables.
//
// No user / profile / team models: DMG is gated by a single shared
// password (see src/lib/auth.ts), not per-user accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel + Neon integration injects DATABASE_URL (pooled, pgbouncer)
  // and DATABASE_URL_UNPOOLED (direct, for migrations). Falling back
  // to DIRECT_URL keeps a non-Vercel setup working too.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────── YOUTUBE CHANNELS ───────────

model Channel {
  id              String    @id @default(cuid())
  // YouTube channel id (UC...)
  ytChannelId     String    @unique
  // Encrypted refresh token from Google OAuth (Pass 2).
  refreshToken    String?
  scopes          String[]  @default([])
  title           String
  handle          String?
  description     String?   @db.Text
  thumbnailUrl    String?
  country         String?
  publishedAt     DateTime?
  lastSyncedAt    DateTime?
  syncIntervalMin Int       @default(60)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  videos    Video[]
  snapshots ChannelSnapshot[]
  reports   AiReport[]
  alerts    Alert[]
  ideas     VideoIdea[]

  @@map("dmg_channels")
}

// Daily snapshot of a channel's aggregate stats — drives time-series charts.
model ChannelSnapshot {
  id                      String   @id @default(cuid())
  channelId               String
  capturedAt              DateTime @default(now())
  subscribers             BigInt
  totalViews              BigInt
  totalVideos             Int
  estimatedMinutesWatched BigInt?
  estimatedRevenue        Decimal? @db.Decimal(10, 2)
  averageViewDuration     Int? // seconds
  ctr                     Decimal? @db.Decimal(5, 4)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, capturedAt])
  @@map("dmg_channel_snapshots")
}

// ─────────── VIDEOS ───────────

enum VideoFormat {
  long
  short
  live
}

model Video {
  id           String      @id @default(cuid())
  channelId    String
  ytVideoId    String      @unique
  title        String
  description  String?     @db.Text
  thumbnailUrl String?
  publishedAt  DateTime
  durationSec  Int
  format       VideoFormat @default(long)
  tags         String[]    @default([])
  // Latest metrics (refreshed on sync).
  views        BigInt      @default(0)
  likes        BigInt      @default(0)
  comments     BigInt      @default(0)
  // AI-derived scores (0-100), null until scored.
  viralityScore Int?
  hookScore     Int?
  retentionRisk Int?
  seoScore      Int?
  aiSummary     String?  @db.Text
  // Cached transcript (when available).
  transcript    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  channel   Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshots VideoSnapshot[]

  @@index([channelId, publishedAt])
  @@index([viralityScore])
  @@map("dmg_videos")
}

model VideoSnapshot {
  id                    String   @id @default(cuid())
  videoId               String
  capturedAt            DateTime @default(now())
  views                 BigInt
  likes                 BigInt
  comments              BigInt
  averageViewDuration   Int?     // seconds
  averageViewPercentage Decimal? @db.Decimal(5, 2)
  ctr                   Decimal? @db.Decimal(5, 4)
  estimatedRevenue      Decimal? @db.Decimal(10, 2)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, capturedAt])
  @@map("dmg_video_snapshots")
}

// ─────────── COMPETITORS ───────────

model Competitor {
  id           String   @id @default(cuid())
  ytChannelId  String   @unique
  title        String
  handle       String?
  thumbnailUrl String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  @@map("dmg_competitors")
}

// ─────────── AI REPORTS ───────────

enum ReportPeriod {
  daily
  weekly
  monthly
}

model AiReport {
  id        String       @id @default(cuid())
  channelId String
  period    ReportPeriod
  startsAt  DateTime
  endsAt    DateTime
  summary   String       @db.Text
  details   Json
  modelUsed String       @default("gpt-4o-mini")
  createdAt DateTime     @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, period, startsAt])
  @@map("dmg_ai_reports")
}

// ─────────── VIDEO IDEAS (AI-generated, channel-style-aware) ───────────

enum IdeaStatus {
  pending
  accepted
  rejected
  produced
}

enum IdeaFormat {
  long
  short
  either
}

model VideoIdea {
  id        String     @id @default(cuid())
  channelId String
  title     String
  hook      String     @db.Text
  outline   String?    @db.Text
  rationale String?    @db.Text
  format    IdeaFormat @default(either)
  tags      String[]   @default([])
  status    IdeaStatus @default(pending)
  source    String     @default("ai") // "ai" | "manual"
  modelUsed String?
  ytVideoId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, status, createdAt])
  @@map("dmg_video_ideas")
}

// ─────────── ALERTS / AUTOMATIONS ───────────

enum AlertChannel {
  email
  discord
  telegram
}

enum AlertCondition {
  viral_video_detected
  ctr_below_threshold
  subscriber_spike
  view_milestone
}

model Alert {
  id            String         @id @default(cuid())
  channelId     String?
  name          String
  condition     AlertCondition
  thresholdJson Json?
  delivery      AlertChannel
  webhookUrl    String?
  email         String?
  enabled       Boolean        @default(true)
  lastFiredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@map("dmg_alerts")
}
