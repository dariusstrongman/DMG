# --- Auth (shared password gate) ---
# The single password your friends use to view the dashboard.
DMG_PASSWORD=dmg123!
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CHANGE this for production. Rotating it forces all existing sessions to expire.
DMG_AUTH_SECRET=replace-with-48-bytes-of-randomness-from-the-command-above

# --- Database (Supabase Postgres — shared with Domain Pulse) ---
# DMG tables are prefixed `dmg_*` to avoid collision.
# From: Supabase → Settings → Database → Connection string → URI
# Use the "Transaction" pooler (port 6543) for runtime queries:
DATABASE_URL=postgresql://postgres.fggruozgfyyheflktcqc:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Use the "Session" pooler (port 5432) for migrations:
DIRECT_URL=postgresql://postgres.fggruozgfyyheflktcqc:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# --- YouTube Data API v3 (Pass 2 — public channel/video metadata, no OAuth) ---
YOUTUBE_API_KEY=AIza...

# --- Google OAuth for YouTube Analytics scope (Pass 2) ---
# Used only when the channel owner authorizes pulling private analytics.
# Authorized redirect URI in Google Cloud Console:
#   https://dmg.stromation.com/auth/youtube/callback
GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR-CLIENT-SECRET

# --- OpenAI (Pass 3 — virality scoring + AI reports) ---
OPENAI_API_KEY=sk-proj-...

# --- Optional: Anthropic Claude alternative ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- App ---
NEXT_PUBLIC_APP_URL=https://dmg.stromation.com
