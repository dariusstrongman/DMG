// Prisma schema for DMG Analytics.
// All tables are prefixed `dmg_*` because this project shares the
// `fggruozgfyyheflktcqc` Supabase Postgres instance with Domain Pulse —
// the prefix prevents collisions with the other product's tables.
//
// No user / profile / team models: DMG is gated by a single shared
// password (see src/lib/auth.ts), not per-user accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Vercel + Neon integration injects DATABASE_URL (pooled, pgbouncer)
  // and DATABASE_URL_UNPOOLED (direct, for migrations). Falling back
  // to DIRECT_URL keeps a non-Vercel setup working too.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────── YOUTUBE CHANNELS ───────────

model Channel {
  id              String    @id @default(cuid())
  // YouTube channel id (UC...)
  ytChannelId     String    @unique
  // Encrypted refresh token from Google OAuth (Pass 2).
  refreshToken    String?
  scopes          String[]  @default([])
  title           String
  handle          String?
  description     String?   @db.Text
  thumbnailUrl    String?
  country         String?
  publishedAt     DateTime?
  lastSyncedAt    DateTime?
  syncIntervalMin Int       @default(60)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  videos    Video[]
  snapshots ChannelSnapshot[]
  reports   AiReport[]
  alerts    Alert[]
  ideas     VideoIdea[]
  viralPicks ViralPick[]
  competitors Competitor[]
  tiktokAccount TiktokAccount?

  @@map("dmg_channels")
}

// AI-synthesized "if you do this exactly, it'll probably go viral" pitch.
// Pulls signal from the entire analytics surface (top performers, best
// posting slots, title patterns, format mix) into ONE concrete pitch.
// Most-recent row per channel is the active pick; older rows are kept
// for history so we can compare predictions to outcomes later.
model ViralPick {
  id               String     @id @default(cuid())
  channelId        String
  title            String
  format           IdeaFormat @default(either)
  postDay          String?    // e.g. "Tuesday"
  postTime         String?    // e.g. "2pm-4pm" (channel-local)
  hook             String     @db.Text
  outline          String     @db.Text
  thumbnailConcept String?    @db.Text
  viralThesis      String?    @db.Text
  riskNote         String?    @db.Text
  tags             String[]   @default([])
  signalUsed       Json?      // snapshot of the analytics inputs at gen time
  modelUsed        String?
  // Set when the user actually produces this pitch as a video. Lets us
  // compare "what the model predicted" vs "how the video performed."
  producedYtVideoId String?
  producedAt       DateTime?
  createdAt        DateTime   @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("dmg_viral_picks")
}

// Daily snapshot of a channel's aggregate stats — drives time-series charts.
model ChannelSnapshot {
  id                      String   @id @default(cuid())
  channelId               String
  capturedAt              DateTime @default(now())
  subscribers             BigInt
  totalViews              BigInt
  totalVideos             Int
  estimatedMinutesWatched BigInt?
  estimatedRevenue        Decimal? @db.Decimal(10, 2)
  averageViewDuration     Int? // seconds
  ctr                     Decimal? @db.Decimal(5, 4)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, capturedAt])
  @@map("dmg_channel_snapshots")
}

// ─────────── VIDEOS ───────────

enum VideoFormat {
  long
  short
  live
}

model Video {
  id           String      @id @default(cuid())
  channelId    String
  ytVideoId    String      @unique
  title        String
  description  String?     @db.Text
  thumbnailUrl String?
  publishedAt  DateTime
  durationSec  Int
  format       VideoFormat @default(long)
  tags         String[]    @default([])
  // Latest metrics (refreshed on sync).
  views        BigInt      @default(0)
  likes        BigInt      @default(0)
  comments     BigInt      @default(0)
  // AI-derived scores (0-100), null until scored.
  viralityScore Int?
  hookScore     Int?
  retentionRisk Int?
  seoScore      Int?
  aiSummary     String?  @db.Text
  // Cached transcript (when available).
  transcript    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  channel   Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshots VideoSnapshot[]

  @@index([channelId, publishedAt])
  @@index([viralityScore])
  @@map("dmg_videos")
}

model VideoSnapshot {
  id                    String   @id @default(cuid())
  videoId               String
  capturedAt            DateTime @default(now())
  views                 BigInt
  likes                 BigInt
  comments              BigInt
  averageViewDuration   Int?     // seconds
  averageViewPercentage Decimal? @db.Decimal(5, 2)
  ctr                   Decimal? @db.Decimal(5, 4)
  estimatedRevenue      Decimal? @db.Decimal(10, 2)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, capturedAt])
  @@map("dmg_video_snapshots")
}

// ─────────── COMPETITORS ───────────

model Competitor {
  id           String   @id @default(cuid())
  // The channel that's tracking this competitor. Each tenant has its
  // own competitor list; the same YouTube channel can be a competitor
  // for multiple tenants (uniqueness is per (channelId, ytChannelId)).
  channelId    String
  ytChannelId  String
  title        String
  handle       String?
  thumbnailUrl String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  channel   Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshots CompetitorSnapshot[]

  @@unique([channelId, ytChannelId])
  @@index([channelId])
  @@map("dmg_competitors")
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  capturedAt   DateTime @default(now())
  subscribers  BigInt
  totalViews   BigInt
  totalVideos  Int

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
  @@map("dmg_competitor_snapshots")
}

// ─────────── AI REPORTS ───────────

enum ReportPeriod {
  daily
  weekly
  monthly
}

model AiReport {
  id        String       @id @default(cuid())
  channelId String
  period    ReportPeriod
  startsAt  DateTime
  endsAt    DateTime
  summary   String       @db.Text
  details   Json
  modelUsed String       @default("gpt-4o-mini")
  createdAt DateTime     @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, period, startsAt])
  @@map("dmg_ai_reports")
}

// ─────────── VIDEO IDEAS (AI-generated, channel-style-aware) ───────────

enum IdeaStatus {
  pending
  accepted
  rejected
  produced
}

enum IdeaFormat {
  long
  short
  either
}

model VideoIdea {
  id        String     @id @default(cuid())
  channelId String
  title     String
  hook      String     @db.Text
  outline   String?    @db.Text
  rationale String?    @db.Text
  format    IdeaFormat @default(either)
  tags      String[]   @default([])
  status    IdeaStatus @default(pending)
  source    String     @default("ai") // "ai" | "manual"
  // Name of the person who submitted this idea (manual entries only).
  // Anyone with the dashboard password can submit; the name lets the
  // owner see who's contributing.
  submittedBy String?
  // AI score 1-10 — predicted viral potential for this channel.
  // Set during generation for AI ideas; set asynchronously after
  // submission for manual ideas.
  aiScore   Int?
  modelUsed String?
  ytVideoId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, status, createdAt])
  @@map("dmg_video_ideas")
}

// ─────────── SETTINGS (runtime config, single-tenant) ───────────

// Simple key-value table for settings the user wants to change without
// editing code: subscriber goal, channel timezone, goal deadline.
// Defaults live in src/lib/config.ts; rows here override them.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("dmg_settings")
}

// ─────────── ALERTS / AUTOMATIONS ───────────

enum AlertChannel {
  email
  discord
  telegram
}

enum AlertCondition {
  viral_video_detected
  ctr_below_threshold
  subscriber_spike
  view_milestone
}

model Alert {
  id            String         @id @default(cuid())
  channelId     String?
  name          String
  condition     AlertCondition
  thresholdJson Json?
  delivery      AlertChannel
  webhookUrl    String?
  email         String?
  enabled       Boolean        @default(true)
  lastFiredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([channelId])
  @@map("dmg_alerts")
}

// One TikTok connection per Channel (tenant). The auth tokens here are
// scoped to the creator's Display API access — read-only profile, stats,
// and video list. Tokens are refreshed by getValidTiktokToken() in
// src/lib/tiktok.ts.
model TiktokAccount {
  id              String    @id @default(cuid())
  channelId       String    @unique
  // TikTok's stable user identifier (different from username, which can change).
  openId          String    @unique
  unionId         String?
  username        String?
  displayName     String?
  avatarUrl       String?   @db.Text
  bioDescription  String?   @db.Text
  isVerified      Boolean   @default(false)
  // Snapshot of stats at last refresh — the dashboard reads these and
  // a daily cron upserts new TiktokAccountSnapshot rows for trends.
  followerCount   Int       @default(0)
  followingCount  Int       @default(0)
  likesCount      BigInt    @default(0)
  videoCount      Int       @default(0)
  // OAuth tokens. accessToken expires in 24h; refreshToken in 365d.
  // Both are encrypted at rest in production via the encryption helper.
  accessToken     String    @db.Text
  refreshToken    String    @db.Text
  accessExpiresAt DateTime
  refreshExpiresAt DateTime
  scope           String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?

  channel   Channel                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshots TiktokAccountSnapshot[]
  videos    TiktokVideo[]

  @@map("dmg_tiktok_accounts")
}

model TiktokAccountSnapshot {
  id              String   @id @default(cuid())
  accountId       String
  capturedAt      DateTime @default(now())
  followerCount   Int
  followingCount  Int
  likesCount      BigInt
  videoCount      Int

  account TiktokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, capturedAt])
  @@map("dmg_tiktok_account_snapshots")
}

model TiktokVideo {
  id              String    @id @default(cuid())
  accountId       String
  // TikTok's video id ("video_id" in Display API responses).
  ttVideoId       String    @unique
  title           String?   @db.Text
  description     String?   @db.Text
  coverImageUrl   String?   @db.Text
  shareUrl        String?   @db.Text
  durationSec     Int       @default(0)
  createdAtTt     DateTime
  // Latest metrics. Refresh is incremental — we keep the latest read
  // here and historical curves in TiktokVideoSnapshot.
  viewCount       BigInt    @default(0)
  likeCount       BigInt    @default(0)
  commentCount   BigInt    @default(0)
  shareCount      BigInt    @default(0)
  lastSyncedAt    DateTime?

  account   TiktokAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  snapshots TiktokVideoSnapshot[]

  @@index([accountId, createdAtTt])
  @@map("dmg_tiktok_videos")
}

model TiktokVideoSnapshot {
  id          String   @id @default(cuid())
  videoId     String
  capturedAt  DateTime @default(now())
  viewCount   BigInt
  likeCount   BigInt
  commentCount BigInt
  shareCount  BigInt

  video TiktokVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, capturedAt])
  @@map("dmg_tiktok_video_snapshots")
}
