# --- Supabase ---
# Shared with Domain Pulse — DMG tables are prefixed `dmg_*` to avoid collision.
NEXT_PUBLIC_SUPABASE_URL=https://fggruozgfyyheflktcqc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server only, never exposed to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Database (Prisma direct connection — Supabase → Settings → Database → Connection string → URI) ---
# Use the "Transaction" pooler for runtime queries:
DATABASE_URL=postgresql://postgres.fggruozgfyyheflktcqc:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Use the "Session" pooler for migrations:
DIRECT_URL=postgresql://postgres.fggruozgfyyheflktcqc:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# --- Google OAuth (for both Supabase Auth login + future YouTube Data API access) ---
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://YOUR-PROJECT.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR-CLIENT-SECRET

# --- YouTube Data API v3 (for public channel/video metadata, no OAuth) ---
YOUTUBE_API_KEY=AIza...

# --- OpenAI (virality scoring + AI reports) ---
OPENAI_API_KEY=sk-proj-...

# --- Optional: Anthropic (for Claude alternative) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- App ---
NEXT_PUBLIC_APP_URL=https://dmg.stromation.com
